# ══════════════════════════════════════════════
# تنظیمات محیطی پروژه arasum-offline
# این فایل را کپی کنید به .env و مقادیر را پر کنید
# هرگز فایل .env را به گیت push نکنید
# ══════════════════════════════════════════════

# ── لاگ‌گیری ──────────────────────────────────
# سطح لاگ: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# مسیر فایل لاگ (اختیاری - خالی = فقط کنسول)
LOG_FILE=

# ── مسیرها ────────────────────────────────────
# مسیر پوشه configs (اختیاری - پیش‌فرض: ./configs)
CONFIGS_DIR=

# ── API ───────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── محیط ──────────────────────────────────────
# development | production
ENVIRONMENT=development